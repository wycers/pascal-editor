{
  "version": 1,
  "rules": [
    {
      "id": "wall-panel-standard",
      "sku": "MH-WALL-PANEL-1220X2440",
      "name": "Standard wall panel",
      "category": "Structure",
      "unit": "pcs",
      "spec": "1220 x 2440 mm panel, net wall area takeoff",
      "match": { "nodeTypes": ["wall"] },
      "quantityMethod": "wall_panel_count",
      "wastePercent": 5,
      "roundTo": 1,
      "pieceSize": { "width": 1.22, "height": 2.44 }
    },
    {
      "id": "wall-stud-track",
      "sku": "MH-WALL-STUD-LM",
      "name": "Wall stud/track allowance",
      "category": "Structure",
      "unit": "m",
      "spec": "Linear framing allowance from wall length",
      "match": { "nodeTypes": ["wall"] },
      "quantityMethod": "wall_length",
      "multiplier": 2,
      "wastePercent": 8,
      "roundTo": 0.1
    },
    {
      "id": "wall-insulation",
      "sku": "MH-WALL-INSULATION-M2",
      "name": "Wall insulation",
      "category": "Envelope",
      "unit": "m2",
      "spec": "Net wall area after openings",
      "match": { "nodeTypes": ["wall"] },
      "quantityMethod": "wall_net_area",
      "wastePercent": 5,
      "roundTo": 0.01
    },
    {
      "id": "floor-board",
      "sku": "MH-FLOOR-BOARD-M2",
      "name": "Floor board / subfloor",
      "category": "Structure",
      "unit": "m2",
      "spec": "Slab polygon area minus holes",
      "match": { "nodeTypes": ["slab"] },
      "quantityMethod": "polygon_area",
      "wastePercent": 5,
      "roundTo": 0.01
    },
    {
      "id": "ceiling-board",
      "sku": "MH-CEILING-BOARD-M2",
